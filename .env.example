# Public application ID of YOUR Microsoft Entra registration. No secret belongs here.
TURTLECLIENT_MS_CLIENT_ID=effe2670-984b-4dc6-89d9-73e11c733c40
# Temporary default: delegate sign-in and renewal to the installed Horizon Launcher.
# Export into the launcher process; Cargo does not automatically load this file.
TURTLECLIENT_AUTH_PROVIDER=horizon
# Optional full path if Horizon is not installed in its standard location.
# TURTLECLIENT_HORIZON_LAUNCHER=C:\path\to\horizon-launcher.exe
# Discord defaults to TurtleClient's existing public application ID; no images are requested.
TURTLECLIENT_DISCORD_APP_ID=1568214525138968586
